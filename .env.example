# ==========================================
# Open-WMS 环境变量配置模板
# ==========================================
# 使用说明：
# 1. 复制此文件并重命名
# 2. 根据实际环境修改配置值
# 3. 在启动应用时加载这些环境变量
# ==========================================

# MySQL 主库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yrt-open-wms
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# MySQL 从库配置
MYSQL_SLAVE_HOST=127.0.0.1
MYSQL_SLAVE_PORT=3306
MYSQL_SLAVE_DATABASE=yrt-open-wms
MYSQL_SLAVE_USERNAME=root
MYSQL_SLAVE_PASSWORD=123456

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=123456

# MongoDB 配置
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=yrt-open-wms
MONGO_USERNAME=wms
MONGO_PASSWORD=123456
MONGO_AUTH_DATABASE=yrt-open-wms

# RabbitMQ 配置
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_USERNAME=rabbit
RABBITMQ_PASSWORD=123456

