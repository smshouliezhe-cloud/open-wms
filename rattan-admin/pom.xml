  <modelVersion>4.0.0</modelVersion>
  <packaging>jar</packaging>
  <artifactId>rattan-admin</artifactId>

  <description>
    web服务入口
  </description>

  <dependencies>
    <!-- Mysql驱动包 -->
    <dependency>
      <groupId>com.mysql</groupId>
